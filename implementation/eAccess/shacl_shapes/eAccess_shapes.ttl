acc-shape:eli-LegalExpression-eli-jurisdiction a sh:PropertyShape ;
    sh:class skos:Concept ;
    sh:path eli:jurisdiction .

acc-shape:eli-LegalResource-eli-jurisdiction a sh:PropertyShape ;
    sh:class skos:Concept ;
    sh:path eli:jurisdiction .

acc-shape:eli-LegalResourceShape sh:property acc-shape:eli-LegalResource-epo-hasResourceType .

acc-shape:eli-LegalResourceSubdivisionShape sh:property acc-shape:eli-LegalResourceSubdivision-epo-hasSubdivision .

acc-shape:epo-InformationRequestShape a sh:NodeShape ;
    rdfs:label "Information Request" ;
    rdfs:isDefinedBy acc-shape:acc-shape ;
    sh:property acc-shape:epo-InformationRequest-epo-concernsLot,
        acc-shape:epo-InformationRequest-epo-concernsLotGroup,
        acc-shape:epo-InformationRequest-epo-concernsProcedure ;
    sh:targetClass :InformationRequest .

acc-shape:epo-InformationResponseShape a sh:NodeShape ;
    rdfs:label "Information Response" ;
    rdfs:isDefinedBy acc-shape:acc-shape ;
    sh:property acc-shape:epo-InformationResponse-epo-sub-answersQuestion ;
    sh:targetClass :InformationResponse .

acc-shape:epo-acc-ESPDRequestShape a sh:NodeShape ;
    rdfs:label "ESPD Request" ;
    rdfs:comment "A document issued by a Buyer defining how the Exclusion Grounds and the Selection Criteria should be addressed in an European Single Procurement Document for a specific procurement." ;
    rdfs:isDefinedBy acc-shape:acc-shape ;
    sh:property acc-shape:epo-acc-ESPDRequest-epo-acc-refersToNotice,
        acc-shape:epo-acc-ESPDRequest-epo-concernsProcedure,
        acc-shape:epo-acc-ESPDRequest-epo-specifiesProcurementCriterion ;
    sh:targetClass :ESPDRequest .

acc-shape:epo-acc-InvitationToTenderShape a sh:NodeShape ;
    rdfs:label "Invitation To Tender" ;
    rdfs:isDefinedBy acc-shape:acc-shape ;
    sh:property acc-shape:epo-acc-InvitationToTender-epo-acc-containsProvidedProcurementDocument,
        acc-shape:epo-acc-InvitationToTender-epo-concernsProcedure,
        acc-shape:epo-acc-InvitationToTender-epo-specifiesEconomicOperator ;
    sh:targetClass :InvitationToTender .

acc-shape:epo-acc-ProcurementDocumentsProvisionShape a sh:NodeShape ;
    rdfs:label "Procurement Documents Provision" ;
    rdfs:comment "The provision by the Buyer to the Economic Operator of the Procurement Documents." ;
    rdfs:isDefinedBy acc-shape:acc-shape ;
    sh:property acc-shape:epo-acc-ProcurementDocumentsProvision-epo-acc-containsProvidedProcurementDocument,
        acc-shape:epo-acc-ProcurementDocumentsProvision-epo-concernsProcedure,
        acc-shape:epo-acc-ProcurementDocumentsProvision-epo-refersToProcurementDocumentsRequest,
        acc-shape:epo-acc-ProcurementDocumentsProvision-epo-specifiesEconomicOperator ;
    sh:targetClass :ProcurementDocumentsProvision .

acc-shape:epo-acc-ProcurementDocumentsRequestShape a sh:NodeShape ;
    rdfs:label "Procurement Documents Request" ;
    rdfs:comment "The request by the Economic Operator to the Buyer to receive the latest version of all the Procurement Documents." ;
    rdfs:isDefinedBy acc-shape:acc-shape ;
    sh:property acc-shape:epo-acc-ProcurementDocumentsRequest-epo-concernsProcedure,
        acc-shape:epo-acc-ProcurementDocumentsRequest-epo-specifiesEconomicOperator ;
    sh:targetClass :ProcurementDocumentsRequest .

acc-shape:epo-acc-ProcurementQuestionReplyShape a sh:NodeShape ;
    rdfs:label "Procurement Question Reply" ;
    rdfs:isDefinedBy acc-shape:acc-shape ;
    sh:property acc-shape:epo-acc-ProcurementQuestionReply-epo-containsInformationReponse ;
    sh:targetClass :ProcurementQuestionReply .

acc-shape:epo-acc-ProcurementQuestionShape a sh:NodeShape ;
    rdfs:label "Procurement Question" ;
    rdfs:isDefinedBy acc-shape:acc-shape ;
    sh:property acc-shape:epo-acc-ProcurementQuestion-epo-containsInformationRequest,
        acc-shape:epo-acc-ProcurementQuestion-epo-specifiesEconomicOperator ;
    sh:targetClass :ProcurementQuestion .

acc-shape:epo-acc-UnsubscribeFromProcedureResponseShape a sh:NodeShape ;
    rdfs:label "Unsubscribe From Procedure Response" ;
    rdfs:isDefinedBy acc-shape:acc-shape ;
    sh:property acc-shape:epo-acc-UnsubscribeFromProcedureResponse-epo-acc-refersToUnsubscribeFromProcedure ;
    sh:targetClass :UnsubscribeFromProcedureResponse .

acc-shape:epo-acc-UnsubscribeFromProcedureShape a sh:NodeShape ;
    rdfs:label "Unsubscribe From Procedure" ;
    rdfs:isDefinedBy acc-shape:acc-shape ;
    sh:property acc-shape:epo-acc-UnsubscribeFromProcedure-epo-concernsProcedure,
        acc-shape:epo-acc-UnsubscribeFromProcedure-epo-specifiesEconomicOperator ;
    sh:targetClass :UnsubscribeFromProcedure .

acc-shape:epo-sub-ESPDShape sh:property acc-shape:epo-sub-ESPD-epo-sub-relatesToESPDRequest .

