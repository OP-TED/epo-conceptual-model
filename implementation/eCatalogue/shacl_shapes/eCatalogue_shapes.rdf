  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-ord-Order-epo-cat-refersToCatalogue">
    <sh:class rdf:resource="http://data.europa.eu/a4g/ontology#PostAwardCatalogue"/>
