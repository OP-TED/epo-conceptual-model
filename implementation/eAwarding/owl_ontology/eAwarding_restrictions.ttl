@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:awa-restriction a owl:Ontology ;
    rdfs:label "eProcurement Ontology - eAwarding restrictions"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology eAwarding restrictions provides the restrictions and the inference-related specifications on the concepts and properties in the eProcurement Ontology eAwarding module."@en ;
    dcterms:issued "2026-07-07"^^xsd:date ;
    dcterms:license "CC BY 4.0" ;
    dcterms:publisher "http://publications.europa.eu/resource/authority/corporate-body/PUBL" ;
    dcterms:title "eProcurement Ontology - eAwarding restrictions"@en ;
    vann:preferredNamespacePrefix "epo-awa" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/ontology#" ;
    rdfs:comment """This version is automatically generated from eAwarding.xml on 
                2026-07-07""" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/home/index.html>,
        <https://github.com/OP-TED/ePO/releases>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology/about>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports :awa,
        eli:,
        cccev:,
        dcterms:,
        skos:,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/adms>,
        <http://www.w3.org/ns/locn>,
        org:,
        <http://www.w3.org/ns/person> ;
    owl:incompatibleWith "4.2.0" ;
    owl:priorVersion "http://data.europa.eu/a4g/ontology#awa-restriction-5.1.0" ;
    owl:versionIRI :awa-restriction-5.2.0 ;
    owl:versionInfo "5.2.0" .

:concernsAwardOutcome rdfs:domain :AwardDecisionNotification ;
    rdfs:range :AwardOutcome .

:concernsProcedure a owl:FunctionalProperty ;
    rdfs:domain :AwardDecisionNotification ;
    rdfs:range :Procedure .

:hasStandstillPeriodEndDate rdfs:domain :AwardDecisionNotification ;
    rdfs:range xsd:date .

:specifiesTenderer a owl:FunctionalProperty ;
    rdfs:domain :AwardDecisionNotification ;
    rdfs:range :Tenderer .

:AwardDecisionNotification rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality 1 ;
            owl:onDataRange xsd:date ;
            owl:onProperty :hasStandstillPeriodEndDate ],
        [ a owl:Restriction ;
            owl:onProperty :concernsAwardOutcome ;
            owl:someValuesFrom :AwardOutcome ],
        [ a owl:Restriction ;
            owl:onClass :Procedure ;
            owl:onProperty :concernsProcedure ;
            owl:qualifiedCardinality 1 ],
        [ a owl:Restriction ;
            owl:onClass :Tenderer ;
            owl:onProperty :specifiesTenderer ;
            owl:qualifiedCardinality 1 ] .

