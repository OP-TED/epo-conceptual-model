  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-awa-AwardDecisionNotification-epo-awa-hasStandstillPeriodEndDate">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#PropertyShape"/>
    <sh:path rdf:resource="http://data.europa.eu/a4g/ontology#hasStandstillPeriodEndDate"/>
    <sh:name>Has standstill period end date</sh:name>
    <sh:description>The end date for the mandatory minimum time frame between the communication of a contract award decision and the formal conclusion of the contract, during which unsuccessful Tenderers have the opportunity to challenge the award before it becomes legally binding.</sh:description>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#awa-shape"/>
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
  </rdf:Description>
