  <rdf:Description rdf:nodeID="N3aaf81fc7ae644fd91349f32d6b3d03b">
    <sh:select>SELECT ?this ?that WHERE { ?this &lt;http://data.europa.eu/a4g/ontology#isSubmittedForShipment&gt; ?that . ?that &lt;http://data.europa.eu/a4g/ontology#isSubmittedForShipment&gt; ?this .}</sh:select>
