  <rdf:Description rdf:about="http://data.europa.eu/a4g/data-shape#epo-ful-DespatcherShape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetClass rdf:resource="http://data.europa.eu/a4g/ontology#Despatcher"/>
    <rdfs:label>Despatcher</rdfs:label>
    <rdfs:comment>The Role of an Agent who sends the goods or notifies of the service or works execution. Additional Information: The Role is carried out by the Supplier or on behalf of the Supplier. This Role is often referred to as the Despatch Party, Consignor or Deliverer.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/a4g/data-shape#ful-shape"/>
  </rdf:Description>
