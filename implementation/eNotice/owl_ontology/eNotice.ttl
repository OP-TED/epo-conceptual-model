:CANDefence-D81 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Contract Award Notice Defence under Directive 81."@en ;
    skos:editorialNote "What is the notice type here?"@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "CAN Defence- D81"@en .

:CANSocial-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Contract Award Notice using the light regime under Directive 25."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "CAN Social- D25"@en .

:CANSocialNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of the results of a call for competition concerning contracts or concessions for social and other specific services."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "CAN Social Notice"@en .

:CANSocialNotice-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Additional information: Social and other specific services – utilities"@en ;
    skos:prefLabel "CAN Social Notice- D25"@en .

:CANStandard-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Contract Award Notice using the standard regime under Directive 24."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "CAN Standard- D24"@en .

:CANStandardNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of the results of a call for competition concerning contracts or concessions."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "CAN Standard Notice"@en .

:CANTransportationNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement that a public service contract for public passenger transport services has been directly awarded."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "CAN Transportation Notice"@en .

:CNDefence-D81 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Competition Notice Defence under Directive 81."@en ;
    skos:editorialNote "What is the notice type here?"@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "CN Defence- D81"@en .

:CNSocial-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Competition Notice using the light regime under Directive 25."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "CN Social- D25"@en .

:CNSocialNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of a call for competition concerning contracts for social and other specific services."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "CN Social Notice"@en .

:CNStandard-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Competition Notice using the standard regime under Directive 24."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "CN Standard- D24"@en .

:CNStandardNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of a call for competition concerning contracts or concessions. Additional information: Contract notices shall be used as a means of calling for competition in respect of all procedures, without prejudice to the relevant articles of the Directive."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "CN Standard Notice"@en .

:CallForExpressionOfInterest a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Invitation for economic operators to be included in a list of pre-selected candidates or vendors, ensuring transparency and competition."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Call For Expression Of Interest"@en .

:CompetitionNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "An announcement of the launch of a Procurement Procedure by a Procuring Entity."@en ;
    skos:historyNote "WG Approval 18/05/2018"@en ;
    skos:prefLabel "Competition Notice"@en .

:CompletionNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "An announcement of the end of a Procurement by a Buyer."@en ;
    skos:prefLabel "Completion Notice"@en .

:ConcessionAwardNotice-D23 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Concession Award Notice under Directive 23."@en ;
    skos:editorialNote "where does this belong to?"@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Concession Award Notice- D23"@en .

:ConcessionNotice-D23 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Concession Notice under Directive 23."@en ;
    skos:editorialNote "where does this belong to?"@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Concession Notice- D23"@en .

:ContractModificationNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "An announcement of the Modification of a Contract/Concession during its term by a Procuring Entity."@en ;
    skos:prefLabel "Contract Modification Notice"@en .

:DesignContest-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Design Contest Notice Directive 24."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Design Contest- D24"@en .

:DesignContest-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Design Contest Notice under Directive 25."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Design Contest- D25"@en .

:DesignContestNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of a call for competition concerning the acquisition, mainly in the fields of town and country planning, architecture and engineering or data processing, of a plan or design selected by a jury."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Design Contest Notice"@en .

:DesignContestResult-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Design Contest Result Notice under Directive 24."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Design Contest Result- D24"@en .

:DesignContestResult-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Design Contest Result Notice under Directive 25."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Design Contest Result- D25"@en .

:DesignContestResultNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of the results of a call for competition concerning the acquisition, mainly in the fields of town and country planning, architecture and engineering or data processing, of a plan or design selected by a jury."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Design Contest Result Notice"@en .

:DirectAwardPrenotificationNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Notice which sets out the Buyer's purchasing intention to award a Contract without prior notification of Competition."@en ;
    skos:prefLabel "Direct Award Prenotification Notice"@en .

:Modification-D23 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Modification Notice under Directive 23."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Modification- D23"@en .

:Modification-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Modification Notice under Directive 24."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Modification- D24"@en .

:Modification-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Modification Notice under Directive 25."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Modification- D25"@en .

:NoticeCEI a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Call for Expression of Interest for purchases below the Public Procurement Directive’s threshold as defined in the Financial Regulation applicable to the general budget of the Union."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Notice CEI"@en .

:NoticeE1 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Voluntary Pre-market Consultation Notice for purchases below the Public Procurement Directive threshold."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Notice E1"@en .

:NoticeE2 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Voluntary Prior Information Notice for purchases below the Public Procurement Directive threshold."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Notice E2"@en .

:NoticeE3 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Voluntary Contract Notice for purchases below the Public Procurement Directive threshold."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Notice E3"@en .

:NoticeE4 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Voluntary Award Notice for purchases below the Public Procurement Directive threshold."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Notice E4"@en .

:NoticeE5 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Voluntary Completion Notice for purchases below the Public Procurement Directive threshold."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Notice E5"@en .

:NoticeE6 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Voluntary Contract Modification Notice for purchases below the Public Procurement Directive threshold."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Notice E6"@en .

:NoticeT01 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Planning notice for public passenger transport services by rail and by road."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Notice T01"@en .

:NoticeT02 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Result notice for public passenger transport services by rail and by road."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Notice T02"@en .

:PIN-CFCSocial-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Prior information notice used as a Call For Competition using the light regime under Directive 25. Additional information: The light regime is generally used for procurement of social and other specific services. The light regime may enable reserving Contracts for social enterprises and sheltered workshops."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "PI N- CFC Social- D25"@en .

:PIN-CFCSocialNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of intentions of planned procurements used as a call for competition concerning contracts for social and other specific services."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "PI N- CFC Social Notice"@en .

:PIN-CFCSocialNotice-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Additional information: Social and other specific services – utilities"@en ;
    skos:prefLabel "PI N- CFC Social Notice- D25"@en .

:PIN-CFCStandard-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Prior information notice used as a Call For Competition using the standard regime under Directive 24. Additional information: The standard regime refers to the core rules for public procurement, which mandates that public authorities award contracts in compliance with EU principles of equal treatment and transparency."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "PI N- CFC Standard- D24"@en .

:PIN-CFCStandardNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of intentions of planned procurements used as a call for competition. Additional information: For restricted procedures and competitive procedures with negotiation, sub-central contracting authorities may use a prior information notice as a call for competition pursuant to the relevant article of the Directive."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "PI N- CFC Standard Notice"@en .

:PIN-RTL-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Prior information notice - Reduced Time Limit under Directive 24."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "PI N- RT L- D24"@en .

:PIN-RTL-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Prior information notice - Reduced Time Limit under Directive 25."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "PI N- RT L- D25"@en .

:PINDefence-D81 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Prior Information Notice Defence under Directive 81."@en ;
    skos:editorialNote "What is the notice type here?"@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "PIN Defence- D81"@en .

:PINOnly-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Prior Information Notice Only under Directive 24."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "PIN Only- D24"@en .

:PINOnly-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Prior Information Notice Only under Directive 25."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "PIN Only- D25"@en .

:PINOnlyNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of intentions of planned procurements for information purposes."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "PIN Only Notice"@en .

:PINProfile-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Prior Information Notice Profile under Directive 24."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "PIN Profile- D24"@en .

:PINProfile-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Prior Information Notice Profile under Directive 25."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "PIN Profile- D25"@en .

:PINProfile-D81 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Prior Information Notice Profile under Directive 81."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "PIN Profile- D81"@en .

:PINProfileNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of intentions of planned procurements."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "PIN Profile Notice"@en .

:PINTimeLimitNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of intentions of planned procurements in view of shortening time limits for reception of tenders. Additional information: Where contracting authorities have published a prior information notice which was not itself used as a means of calling for competition, the minimum time limit for the receipt of tenders may be shortened."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "PIN Time Limit Notice"@en .

:PINTransportationNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of the intention to award a public service contract for public passenger transport services."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "PIN Transportation Notice"@en .

:PlanningNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Notice which sets out the Contracting Authority's purchasing intentions. It is used by Contracting Authorities to provide Suppliers with information about a Procurement Process."@en ;
    skos:editorialNote "When backwards compatibility to StandardForms is no longer required, switch to establishing the notice type constraint at this level."@en ;
    skos:prefLabel "Planning Notice"@en .

:PreMarketConsultationNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of a pre-market consultation. Additional information: A pre-market consultation is not a call for competition and no procurement documents are available at the time of consultation. A consultation may or may not be followed by a future competition."@en ;
    skos:historyNote "WG Approval 02/05/2024"@en ;
    skos:prefLabel "Pre Market Consultation Notice"@en .

:QS-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Qualification System under Directive 25."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Q S- D25"@en .

:QSNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of a system of qualification of economic operators on the basis of exclusion and selection criteria. Additional information: The announcement can be used as a call for competition. When a call for competition is made by means of a notice on the existence of a qualification system, specific contracts for the works, supplies or services covered by the qualification system shall be awarded by restricted procedures or negotiated procedures, in which all tenderers and participants are selected among the candidates already qualified in accordance with such a system."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "QS Notice"@en .

:ResultNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "An announcement of the award or non-award of a Contract by a Buyer."@en ;
    skos:historyNote "WG Approval 27/03/2019"@en ;
    skos:prefLabel "Result Notice"@en .

:SocialAndOtherSpecificServices-D23 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Social And Other Specific Services under Directive 23."@en ;
    skos:editorialNote "This can be PIN or Concession award notice"@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Social And Other Specific Services- D23"@en .

:SocialAndOtherSpecificServices-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Social And Other Specific Services under Directive 24."@en ;
    skos:editorialNote "This can be PIN (maybe CFC), CN or CAN."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Social And Other Specific Services- D24"@en .

:StandardFormsNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Standard Forms Notice"@en ;
    skos:prefLabel "Standard Forms Notice"@en .

:Subcontract-D81 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Subcontract Notice under Directive 81."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "Subcontract- D81"@en .

:SubcontractNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of a call for competition by successful tenderers which are not contracting authorities/entities concerning contracts for social and other specific services."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Subcontract Notice"@en .

:VEAT-D23 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Voluntary ex-ante transparency notice under Directive 23."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "VEA T- D23"@en .

:VEAT-D24 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Voluntary ex-ante transparency notice under Directive 24."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "VEA T- D24"@en .

:VEAT-D25 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Voluntary ex-ante transparency notice under Directive 25."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "VEA T- D25"@en .

:VEAT-D81 a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Voluntary ex-ante transparency notice under Directive 81."@en ;
    skos:historyNote "WG approval 16/09/2025"@en ;
    skos:prefLabel "VEA T- D81"@en .

:VoluntaryEx-AnteTransparencyNotice a owl:Class ;
    rdfs:isDefinedBy :not ;
    skos:definition "Announcement of the intention to award of a contract without prior publication of a contract notice."@en ;
    skos:historyNote "WG approval 09/10/2025"@en ;
    skos:prefLabel "Voluntary Ex- Ante Transparency Notice"@en .

:announcesAwardDecision a owl:ObjectProperty ;
    rdfs:isDefinedBy :not ;
    skos:definition "Relation indicating the formal communication of an Award Decision."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "announces Award Decision"@en .

