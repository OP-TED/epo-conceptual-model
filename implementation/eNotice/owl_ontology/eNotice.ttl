    skos:definition "Relation indicating the formal communication of a Lot Group Award Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "announces Lot Group Award Information"@en .

:announcesNoticeAwardInformation a owl:ObjectProperty ;
    rdfs:isDefinedBy :not ;
    skos:definition "Relation indicating the formal communication of a Notice Award Information."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "announces Notice Award Information"@en .

:announcesPlannedProcurement a owl:ObjectProperty ;
    rdfs:isDefinedBy :not ;
    skos:definition "Relation indicating the formal communication of a Planned Procurement."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "announces Planned Procurement"@en .

:announcesPlannedProcurementPart a owl:ObjectProperty ;
    rdfs:isDefinedBy :not ;
    skos:definition "Relation indicating the formal communication of a Planned Procurement Part."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "announces Planned Procurement Part"@en .

:announcesProcedure a owl:ObjectProperty ;
    rdfs:isDefinedBy :not ;
    skos:definition "Relation indicating the formal communication of a Procedure."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "announces Procedure"@en .

:announcesReviewDecision a owl:ObjectProperty ;
    rdfs:isDefinedBy :not ;
    skos:definition "Relation indicating the formal communication of a Review Decision."@en ;
    skos:prefLabel "announces Review Decision"@en .

:announcesReviewRequest a owl:ObjectProperty ;
    rdfs:isDefinedBy :not ;
    skos:definition "Relation indicating the formal communication of a Review Request."@en ;
    skos:historyNote "WG approval 25/09/2025"@en ;
    skos:prefLabel "announces Review Request"@en .

:announcesRole a owl:ObjectProperty ;
    rdfs:isDefinedBy :not ;
