:not a owl:Ontology ;
    rdfs:label "eProcurement Ontology - eNotice"@en ;
    dcterms:created "2021-06-01"^^xsd:date ;
    dcterms:description "The eProcurement Ontology eNotice module describes the concepts and properties representing the Electronic Notice domain. The provision of these semantics offers the basis for a common understanding of the domain for all stakeholders ensuring the quality of data exchange and transparency. The ontology restrictions are published in a separate artefact."@en ;
