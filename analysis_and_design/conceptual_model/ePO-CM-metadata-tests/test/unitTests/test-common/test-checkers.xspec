        <x:call function="f:isValidQname">
            <x:param name="input">normalizedString</x:param>
        </x:call>
        <x:expect label="is valid" select="false()"/>
    </x:scenario>
    
    <x:scenario label="Check if local name from Qname is camelCase with first letter uppercased">
