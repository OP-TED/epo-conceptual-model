    <x:scenario label="Check if text contains WG approval metadata">
        <x:scenario label="Simple case of WG approval metadata">
            <x:call function="f:hasWgApprovalMetadata">
                <x:param name="text" select="'WG Approval 16/01/2019'"/>
            </x:call>
            <x:expect label="a list with namespaces that were not defined" select="true()"/>
        </x:scenario>
        <x:scenario label="A definition without WG approval">
            <x:call function="f:hasWgApprovalMetadata">
                <x:param name="text" select="'Any additional information about the recurrence of the Procurement.'"/>
            </x:call>
            <x:expect label="a list with namespaces that were not defined" select="true()"/>
        </x:scenario>
        <x:scenario label="WG approval metadata with different data format">
            <x:call function="f:hasWgApprovalMetadata">
                <x:param name="text" select="'Any additional information about the recurrence of the Procurement.&#xA;&#xA;Additional Information:&#xA;For example estimated timing of the Procedure.&#xA;&#xA;This corresponds in eForms to BT-95 Recurrence Description.&#xA;&#xA;(WG approval 2019-01-16)&#xA;'"/>
            </x:call>
            <x:expect label="a list with namespaces that were not defined" select="true()"/>
        </x:scenario>
        <x:scenario label="WG approval metadata with different text used">
            <x:call function="f:hasWgApprovalMetadata">
                <x:param name="text" select="'Web page where tools and devices for electronic communication that are not generally available can be downloaded free of charge.&#xA;&#xA;Additional Information:&#xA;&#xA;This corresponds in eForms to BT-724 Tool Atypical.&#xA;&#xA;&#xA;WG Acceptance 10/01/2023'"/>
            </x:call>
            <x:expect label="a list with namespaces that were not defined" select="true()"/>
        </x:scenario>
    </x:scenario>
    
    <x:scenario focus="WIP" label="f:hasBtgTermIdMetadata">
        <x:scenario label="Simple case of BT id metadata">
            <x:call function="f:hasBtgTermIdMetadata">
